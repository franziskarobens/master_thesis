\renewcommand*{\inittitle}{%
  \ifx\@place\@empty
    \place{%
      Aachen%
    }
  \fi
  \ifx\@mainlogo\@empty
    \IfFileExists{rwth-isw-en-cmyk.jpg}{%
      \scr@ifundefinedorrelax{includegraphics}{%
        \if@atdocument\else\RequirePackage{graphicx}\fi
      }{}%
      \scr@ifundefinedorrelax{includegraphics}{}{%
        \mainlogo{%
          \includegraphics[width=80mm]
                          {rwth-isw-en-cmyk.jpg}
        }%
      }%
    }{}%
  \fi
  \ifx\@titlepagefont\@empty
    \renewcommand*{\@titlepagefont}{%
      \normalfont
    }%
  \fi
}
\renewcommand*{\makemaintitle}{%
  \begin{%
    titlepage}
    \providecaptionname{german,ngerman,austrian,naustrian,%
      swissgerman,nswissgerman}{\indatename}{}
    \providecaptionname{american,australian,british,canadian,%
      english,newzealand,UKenglish,USenglish}{\indatename}{}
    \providecaptionname{american,australian,british,canadian,%
         english,newzealand,UKenglish,USenglish}{\presentedbyname}{submitted to the\\
            Faculty of Mathematics, Computer Science and Natural Sciences\\
            of RWTH Aachen University\\ 
            by}
    \providecaptionname{american,australian,british,canadian,%
        english,newzealand,UKenglish,USenglish}{\refereename}{Reviewer}
    \providecaptionname{american,australian,british,canadian,%
        english,newzealand,UKenglish,USenglish}{\advisorname}{Supervisor}
    \providecaptionname{german,ngerman,austrian,naustrian,%
      swissgerman,nswissgerman}{\advisorname}{Betreuung}
    \setlength{\parskip}{\z@}%
    \setlength{\parindent}{\z@}%
    \setlength{\parfillskip}{\z@\@plus 1fil}%
    \linespread{1}\selectfont
    \@titlepagefont
    \vspace*{.5\baselineskip}
    %\hfill
%    \begin{tabular}[r]{@{}c@{}}
%      \raisebox{\dimexpr\ht\strutbox-\height}{\@secondlogo}\\
%    \end{tabular}\par
    \vspace{5\baselineskip}
    \centering
    {\LARGE\bfseries\titlefont{\@title\par}}%
    \vspace{5\baselineskip}
    {\Large\subject@font{\@subject\par}}%
    \vspace{\baselineskip}
    \presentationinformationISW\par
    \vspace{3\baselineskip}
    \presentedbyname\\[\baselineskip]
    {\Large\csname @authorfont\endcsname{\usenonemptytitleelement{author}\par
    \vspace{.5\baselineskip}}}
    \matriculationnumbername\ \usenonemptytitleelement{matriculationnumber}\par%
    \vfill
    \centering
    \begin{minipage}{60mm}
    \@hangfrom{\advisorname: }{\@advisor\par}%
    \newcommand*{\test@male@female}[1][m]{%
      \global\advance\@tempcnta by\@ne
      \Ifstr{##1}{f}{\def\fe@male{female}}{\def\fe@male{male}}%
      \@hangfrom{\csname ordinal\fe@male refereename\endcsname{\@tempcnta}: }%
      \def\and{\par\test@male@female}%
    }%
    \@tempcnta \z@
    \expandafter\test@male@female\@referee
    \end{minipage}\par
    \vspace{1\baselineskip}\centering
    \@place, \Ifstr{\indatename}{}{}{\indatename\ }\@date\par
    \centering\vspace{2\baselineskip}
    \begin{tabular}[t]{@{}c@{}}
      \raisebox{\dimexpr\ht\strutbox-\height}{\@mainlogo}\\
      \@chair\\
    \end{tabular}\par
  \end{%
    titlepage}
}
